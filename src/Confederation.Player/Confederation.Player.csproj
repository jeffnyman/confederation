<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>confederation</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Icons\confederation.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- SDL3 ships native libraries for every platform; a desktop player does not need the Android
       and iOS ones, which are most of the package -->
  <Target Name="ConfederationTrimMobileNatives" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^runtimes[\/](android|ios)'))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Confederation.Player.Tests" />
    <ProjectReference Include="..\Confederation.Core\Confederation.Core.csproj" />
    <PackageReference Include="ppy.SDL3-CS" />
  </ItemGroup>

  <!-- the games the repository includes, by Electronic Arts' permission (see NOTICE.md), beside
       the player, where it plays them from when they aren't set up elsewhere: games/wc1, games/wc2 -->
  <ItemGroup>
    <None Include="..\..\games\**\*" Exclude="..\..\games\**\*.md" LinkBase="games" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- the games' icons, and the player's own, for their windows: read by name, as Icons/wc1.ico -->
  <ItemGroup>
    <EmbeddedResource Include="Icons\*.ico" LogicalName="Icons/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
